{
  "name": "playwright-testing-suite",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:headed:chromium": "playwright test --headed --project=chromium",
    "test:headed:firefox": "playwright test --headed --project=firefox",
    "test:headed:webkit": "playwright test --headed --project=webkit",
    "test:chrome": "playwright test --project=chromium",
    "test:parallel": "playwright test --workers=4",
    "test:tag": "playwright test --grep @smoke",
    "test:tag1": "playwright test --grep @regression",
    "test:load": "k6 run tests/performance/loadtest.js",
    "test:dev": "set ENV=dev&& playwright test",
    "test:staging": "set ENV=staging&& playwright test",
    "test:prod": "set ENV=prod&& playwright test",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "lint:ci": "eslint . --ext .js --max-warnings 0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.0",
    "@playwright/test": "^1.45.0",
    "dotenv": "^16.4.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0"
  },
  "author": "Syed Yousaf Raza",
  "license": "UNLICENSED",
  "description": "Playwright, API, and k6 test automation suite"
}
